#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:16
msgid "Problem report"
msgstr "Reporte de problemas"

#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:17
msgid "There are two ways to generate a problem report in CSV format"
msgstr "Existen dos maneras de generar reportes de problemas en formato CSV"

#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:20
#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:26
msgid "Summary Report"
msgstr "Reporte Resumen"

#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:20
msgid ""
"Generates a report of all problem-type blocks showing attempts, obtained "
"score and possible score of each student."
msgstr ""
"Genera un reporte de todos los bloques tipo pregunta mostrando los "
"intentos, puntaje obtenido y puntaje posible del bloque de cada estudiante."

#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:23
#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:27
msgid "Complete Report"
msgstr "Reporte Completo"

#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:23
msgid ""
"Generates a report of all questions in problem-type blocks showing the "
"question, students answer, correct answer, attempts, obtained score and "
"block possible score for each student."
msgstr ""
"Genera un reporte de todas las preguntas de los bloques tipo pregunta "
"mostrando la pregunta, respuesta del estudiante, respuesta correcta, "
"intentos, puntaje obtenido y puntaje posible del bloque."

#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:31
msgid "watch the tutorial"
msgstr "ver este tutorial"

#: xblockcompletion/templates/instructor/instructor_dashboard_2/eol_xblock_completion.html:33
#, python-brace-format
msgid ""
"For better data visualization and handling of the data in Excel, you can "
"{link}."
msgstr ""
"Para una mejor visualización y manejo de los datos en Excel, puedes "
"{link}."

